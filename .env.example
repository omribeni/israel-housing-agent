# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Claude API — get from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Telegram Bot — create via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID — send a message to your bot, then call
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat_id
TELEGRAM_CHAT_ID=

# SQLite database path (default: data/housing.db)
DB_PATH=data/housing.db

# Telegram Channel Monitoring — get from https://my.telegram.org/apps
# Optional: if not set, the Telegram channel collector is skipped
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
